{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "$CONTEXT7_API_KEY"],
      "enabled": true
    },
    "cogley": {
      "type": "remote",
      "url": "https://mcp.cogley.ai/",
      "headers": {
        "Authorization": "Bearer $COGLEY_API_KEY"
      },
      "enabled": true
    },
    "respondent": {
      "type": "remote",
      "url": "http://localhost:22080/mcp",
      "headers": {
        "Authorization": "Bearer $RESPONDENT_MCP_TOKEN"
      },
      "enabled": true
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "kimi-dev-72b": {
          "name": "kimi-dev-72b"
        },
        "zai-org/glm-4.7-flash": {
          "name": "zai-org/glm-4.7-flash"
        },
        "meta/muse-glimmer": {
          "name": "meta/muse-glimmer"
        },
        "google/gemma-4-31b-qat": {
          "name": "google/gemma-4-31b-qat"
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen/qwen3.8-27b"
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "qwen/qwen3.6-35b-a3b"
        },
        "qwen/qwen3-vl-30b": {
          "name": "qwen/qwen3-vl-30b"
        },
        "txgsync/gpt-oss-120b-Derestricted-mxfp4-mlx": {
          "name": "txgsync/gpt-oss-120b-Derestricted-mxfp4-mlx"
        }
      }
    }
  }
}